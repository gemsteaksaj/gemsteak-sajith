---
import Crystal from "./Crystal.astro";
import GemLogo from "./GemLogo.astro";
import { hero } from "../data/cv";

const sparkles = [
  { l: "8%", t: "22%", c: "var(--color-cyan)", d: "2.2s", delay: "0s" },
  { l: "18%", t: "48%", c: "var(--color-pink)", d: "3s", delay: ".6s" },
  { l: "86%", t: "18%", c: "var(--color-gold)", d: "2.6s", delay: ".3s" },
  { l: "92%", t: "44%", c: "var(--color-cyan)", d: "2s", delay: "1.1s" },
  { l: "30%", t: "12%", c: "var(--color-lilac)", d: "3.4s", delay: ".9s" },
  { l: "72%", t: "30%", c: "var(--color-pink)", d: "2.8s", delay: "1.4s" },
];
---

<section id="top" class="relative isolate min-h-[100svh] overflow-hidden" aria-labelledby="hero-title" data-hero>
  <!-- ============ PARALLAX LANDSCAPE ============ -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <!-- moon -->
    <div class="absolute right-[12%] top-[16%] h-24 w-24 sm:h-32 sm:w-32" data-depth="0.15">
      <div class="h-full w-full rounded-full border-4 border-ink bg-[radial-gradient(circle_at_35%_35%,#fffbe8,#ffe7a8_55%,#f2c46b)] shadow-[0_0_60px_rgb(255_231_168/0.55)]">
        <span class="absolute left-[28%] top-[30%] h-4 w-4 rounded-full bg-[#e8bf6a]/70"></span>
        <span class="absolute left-[55%] top-[55%] h-6 w-6 rounded-full bg-[#e8bf6a]/60"></span>
        <span class="absolute left-[60%] top-[22%] h-3 w-3 rounded-full bg-[#e8bf6a]/60"></span>
      </div>
    </div>

    {sparkles.map((s) => (
      <span class="sparkle" style={`left:${s.l};top:${s.t};--c:${s.c};--d:${s.d};--delay:${s.delay}`}></span>
    ))}

    <!-- far: mountains + castle -->
    <svg class="absolute inset-x-0 bottom-0 h-[62%] w-full" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice" data-depth="0.25">
      <path d="M0 600 L0 330 L140 250 L260 320 L420 190 L560 300 L700 236 L830 286 L930 214 L1050 290 L1150 178 L1250 178 L1360 296 L1460 250 L1600 290 L1600 600 Z" fill="#3a2b7a" stroke="#0b0b12" stroke-width="5" stroke-linejoin="round" />
      <!-- snow caps / facet highlights -->
      <path d="M420 190 L455 240 L430 232 L405 250 L390 226 Z" fill="#8f7bd8" stroke="#0b0b12" stroke-width="4" stroke-linejoin="round" />
      <path d="M930 214 L960 248 L934 244 L914 258 L904 236 Z" fill="#8f7bd8" stroke="#0b0b12" stroke-width="4" stroke-linejoin="round" />
      <!-- castle -->
      <g transform="translate(1200 182)">
        <g fill="#251a58" stroke="#0b0b12" stroke-width="5" stroke-linejoin="round">
          <rect x="-46" y="-118" width="92" height="118" />
          <rect x="-92" y="-96" width="34" height="96" />
          <rect x="58" y="-96" width="34" height="96" />
          <rect x="-16" y="-178" width="32" height="64" />
          <path d="M-98 -96 L-75 -146 L-52 -96 Z" fill="#e0234e" />
          <path d="M52 -96 L75 -146 L98 -96 Z" fill="#e0234e" />
          <path d="M-24 -178 L0 -232 L24 -178 Z" fill="#ff4fa3" />
          <path d="M-46 -118 v-14 h14 v10 h13 v-10 h14 v10 h13 v-10 h14 v10 h13 v-10 h11 v14" />
          <path d="M-14 0 v-34 a14 14 0 0 1 28 0 v34 Z" fill="#0b0b12" />
        </g>
        <path d="M0 -232 v-26 l26 8 l-26 8" fill="#3ff3ff" stroke="#0b0b12" stroke-width="4" stroke-linejoin="round" />
        <g fill="#ffd25e" class="castle-windows">
          <rect x="-30" y="-92" width="10" height="16" rx="4" />
          <rect x="20" y="-92" width="10" height="16" rx="4" />
          <rect x="-80" y="-70" width="10" height="14" rx="4" />
          <rect x="70" y="-70" width="10" height="14" rx="4" />
          <rect x="-5" y="-158" width="10" height="16" rx="4" />
        </g>
      </g>
    </svg>

    <!-- mid: hills + crystals -->
    <svg class="absolute inset-x-0 bottom-0 h-[55%] w-full" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice" data-depth="0.45">
      <path d="M0 600 L0 420 Q200 350 400 408 T800 398 T1200 386 T1600 400 L1600 600 Z" fill="#2a1f62" stroke="#0b0b12" stroke-width="5" stroke-linejoin="round" />
      <Crystal x={250} y={402} s={0.9} hue="cyan" />
      <Crystal x={720} y={400} s={0.7} hue="amethyst" />
      <Crystal x={1330} y={392} s={1} hue="pink" flip />
    </svg>

    <!-- near: foreground ridge + big rubies -->
    <svg class="absolute inset-x-0 bottom-0 h-[40%] w-full" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice" data-depth="0.7">
      <path d="M0 600 L0 500 Q300 430 600 488 T1200 478 T1600 466 L1600 600 Z" fill="#170f3d" stroke="#0b0b12" stroke-width="5" stroke-linejoin="round" />
      <Crystal x={120} y={498} s={1.7} hue="ruby" />
      <Crystal x={940} y={486} s={0.8} hue="cyan" flip />
      <Crystal x={1490} y={472} s={1.9} hue="ruby" flip />
    </svg>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-night-1"></div>
  </div>

  <!-- ============ TITLE SCREEN CONTENT ============ -->
  <div class="mx-auto flex min-h-[100svh] max-w-5xl flex-col items-center justify-center px-4 pb-[22vh] pt-28 text-center">
    <div class="mb-4 drop-shadow-[0_0_30px_rgb(224_35_78/0.6)]" data-hero-in>
      <GemLogo size={92} uid="hero-logo" class="animate-[float_4s_ease-in-out_infinite]" />
    </div>

    <p class="mb-3 inline-flex items-center gap-2 rounded-full border-[3px] border-ink bg-night-0/80 px-4 py-1 text-xs font-extrabold tracking-[0.25em] text-gold shadow-[0_3px_0_var(--color-ink)]" data-hero-in>
      ◆ MAIN MENU · PRESS START ◆
    </p>

    <h1 id="hero-title" class="title-display text-[clamp(3.6rem,13vw,9rem)]" data-text={hero.title} data-hero-in>
      {hero.title}
    </h1>

    <p class="ribbon mt-6" data-hero-in>{hero.subtitle}</p>

    <ul class="mt-8 flex flex-wrap items-center justify-center gap-3" aria-label="Contact details" data-hero-in>
      {hero.contacts.map((c) => (
        <li>
          {c.href ? (
            <a class="chip" href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}>
              <span aria-hidden="true">{c.icon}</span>{c.label}
            </a>
          ) : (
            <span class="chip"><span aria-hidden="true">{c.icon}</span>{c.label}</span>
          )}
        </li>
      ))}
    </ul>

    <a href="#story" class="gem-btn mt-10" data-hero-in>
      <span class="gem-btn__rim">
        <span class="gem-btn__face"><span aria-hidden="true">▶</span>{hero.cta}<span aria-hidden="true">✦</span></span>
      </span>
    </a>

    <a href="#story" class="scroll-hint mt-10 text-sm font-extrabold tracking-[0.3em] text-lilac/80" aria-hidden="true" tabindex="-1">
      ▼ SCROLL ▼
    </a>
  </div>
</section>
