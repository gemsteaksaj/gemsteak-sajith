---
// THE VAULT: one tabbed container holding Projects, Achievements and Guilds.
// All content comes from src/data/vault.ts; add entries there and this renders them.
import SectionHead from "./SectionHead.astro";
import { vault, projects, achievements, guilds, type Tier } from "../data/vault";

const slotsFor = (n: number) => Math.max(vault.rowSize, Math.ceil(n / vault.rowSize) * vault.rowSize);
const lockedFor = (n: number) => Array.from({ length: slotsFor(n) - n }, (_, i) => n + i + 1);
const pad = (n: number) => String(n).padStart(2, "0");
const medal = (tier: Tier = "gold") => (tier === "gold" ? "" : `is-${tier}`);
const isExternal = (href: string) => /^https?:\/\//.test(href);

const tabs = [
  { key: "projects", label: "Projects", icon: "🗺️", gem: "gem-ruby", count: projects.length },
  { key: "achievements", label: "Achievements", icon: "🏆", gem: "gem-gold", count: achievements.length },
  { key: "guilds", label: "Guilds", icon: "🛡️", gem: "gem-cyan", count: guilds.length },
];
const total = projects.length + achievements.length + guilds.length;
---

<section id="archives" class="relative mx-auto max-w-6xl px-4 py-24" aria-labelledby="archives-title">
  <SectionHead id="archives-title" title={vault.heading} kicker={vault.kicker} icon="🗝️" tone="lilac" iconBg="var(--color-amethyst)" />

  <div class="vault" data-vault data-reveal>
    <span class="rivet left-2.5 top-2.5 hidden sm:block" aria-hidden="true"></span>
    <span class="rivet right-2.5 top-2.5 hidden sm:block" aria-hidden="true"></span>
    <span class="rivet bottom-2.5 left-2.5 hidden sm:block" aria-hidden="true"></span>
    <span class="rivet bottom-2.5 right-2.5 hidden sm:block" aria-hidden="true"></span>

    <!-- ============ tab bar ============ -->
    <div class="flex flex-wrap items-center justify-between gap-4 px-2 pt-1">
      <div class="vault-tabs" role="tablist" aria-label="Archive categories">
        {tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`vault-tab-${t.key}`}
            class:list={["vault-tab", t.gem]}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`vault-panel-${t.key}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span aria-hidden="true">{t.icon}</span>
            {t.label}
            <span class="vault-tab__count">{t.count}<span class="sr-only"> unlocked</span></span>
          </button>
        ))}
      </div>
      <p class="hidden sm:block"><span class="vault-chip is-dark"><span class="text-cyan" aria-hidden="true">◆</span> {total} unlocked</span></p>
    </div>

    <div class="vault__floor">
      <!-- ============ PROJECTS: level select ============ -->
      <div id="vault-panel-projects" role="tabpanel" aria-labelledby="vault-tab-projects" tabindex="0">
        {projects.length === 0 && (
          <div class="panel-slate mb-8 flex flex-col items-start gap-4 p-5 sm:flex-row sm:items-center sm:justify-between" role="status">
            <div class="flex items-center gap-4">
              <span class="grid h-12 w-12 flex-none place-items-center rounded-full border-4 border-ink bg-gold text-2xl shadow-[0_4px_0_var(--color-ink)] animate-[float_3s_ease-in-out_infinite]" aria-hidden="true">⏳</span>
              <p class="font-display text-[1.35rem] leading-tight text-gold [text-shadow:0_3px_0_var(--color-ink)]">{vault.lockedMessage}</p>
            </div>
            <div class="h-5 w-full flex-none overflow-hidden rounded-full border-[3px] border-ink bg-night-0 sm:w-64" aria-hidden="true">
              <div class="h-full w-[62%] rounded-full border-r-[3px] border-ink bg-[repeating-linear-gradient(-45deg,var(--color-ruby)_0_14px,var(--color-pink)_14px_28px)] bg-[length:56px_100%] animate-[loading-bar_1s_linear_infinite]"></div>
            </div>
          </div>
        )}

        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p, i) => (
            <li class="level-card" data-vault-item>
              <article class="level-card__inner flex flex-col gap-3 p-5">
                {p.image && (
                  <img src={p.image} alt={p.imageAlt ?? ""} loading="lazy" class="aspect-video w-full rounded-lg border-[3px] border-ink object-cover" />
                )}
                <div class="flex items-center justify-between gap-2">
                  <span class="whitespace-nowrap text-xs font-extrabold tracking-[0.25em] text-pink">LEVEL {pad(i + 1)}</span>
                  {p.status && <span class="vault-chip">{p.status}</span>}
                </div>
                <h3 class="text-2xl leading-tight text-white [text-shadow:0_3px_0_var(--color-ink)]">{p.title}</h3>
                {p.year && <p class="-mt-2 text-sm font-extrabold text-gold">{p.year}</p>}
                <p class="text-lilac">{p.blurb}</p>
                {p.tags && p.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-2" aria-label="Tech used">
                    {p.tags.map((tag) => <li class="vault-tag">{tag}</li>)}
                  </ul>
                )}
                {p.links && p.links.length > 0 && (
                  <div class="mt-auto flex flex-wrap gap-2 pt-2">
                    {p.links.map((l) => (
                      <a
                        class="btn-stone text-sm"
                        href={l.href}
                        target={isExternal(l.href) ? "_blank" : undefined}
                        rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
                      >
                        {l.label} ▶
                      </a>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}

          {lockedFor(projects.length).map((n) => (
            <li class="level-card" tabindex="0" data-vault-item aria-label={`Level ${pad(n)}, locked`}>
              <div class="level-card__inner flex min-h-64 flex-col items-center justify-center gap-4 p-6 text-center" aria-hidden="true">
                <svg width="76" height="84" viewBox="0 0 76 84" class="drop-shadow-[0_0_18px_rgb(166_107_255/0.6)]">
                  <path d="M18 38 V26 a20 20 0 0 1 40 0 V38" fill="none" stroke="#0b0b12" stroke-width="14" stroke-linecap="round" />
                  <path d="M18 38 V26 a20 20 0 0 1 40 0 V38" fill="none" stroke="#b9c0d0" stroke-width="7" stroke-linecap="round" />
                  <rect x="6" y="36" width="64" height="44" rx="10" fill="#ffd25e" stroke="#0b0b12" stroke-width="5" />
                  <path d="M6 50 h64" stroke="#e8a92a" stroke-width="5" />
                  <circle cx="38" cy="56" r="6" fill="#0b0b12" />
                  <path d="M38 58 v10" stroke="#0b0b12" stroke-width="5" stroke-linecap="round" />
                </svg>
                <span class="text-xs font-extrabold tracking-[0.3em] text-pink">LEVEL {pad(n)}</span>
                <span class="font-display text-4xl tracking-[0.2em] text-white/90 [text-shadow:0_4px_0_var(--color-ink)]">???</span>
                <span class="vault-chip is-dark">Locked</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- ============ ACHIEVEMENTS: trophy room ============ -->
      <div id="vault-panel-achievements" role="tabpanel" aria-labelledby="vault-tab-achievements" tabindex="0" hidden>
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {achievements.map((a) => (
            <li class="trophy" data-vault-item>
              <span class:list={["badge-medal", medal(a.tier)]} aria-hidden="true">{a.icon}</span>
              <h3 class="text-[1.45rem] leading-tight text-white [text-shadow:0_3px_0_var(--color-ink)]">{a.title}</h3>
              {a.detail && <p class="font-semibold leading-snug text-lilac">{a.detail}</p>}
              {a.year && <span class="vault-chip mt-auto">{a.year}</span>}
            </li>
          ))}

          {lockedFor(achievements.length).map(() => (
            <li class="trophy is-locked" data-vault-item aria-label="Achievement slot, locked">
              <span class="badge-medal is-locked" aria-hidden="true">?</span>
              <span class="font-display text-3xl tracking-[0.2em] text-white/70 [text-shadow:0_3px_0_var(--color-ink)]" aria-hidden="true">???</span>
              <span class="vault-chip is-dark mt-auto" aria-hidden="true">Locked</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- ============ GUILDS: adventurer's badge board ============ -->
      <div id="vault-panel-guilds" role="tabpanel" aria-labelledby="vault-tab-guilds" tabindex="0" hidden>
        <div class="board">
          <div class="board__cork">
            <ul class="grid gap-x-6 gap-y-10 pt-2 sm:grid-cols-2 lg:grid-cols-3">
              {guilds.map((g, i) => (
                <li
                  class:list={[
                    "guild-note relative flex flex-col gap-3 rounded-xl border-4 border-ink bg-parchment px-4 pb-5 pt-6 text-[#2a1d10] shadow-[4px_4px_0_var(--color-ink)]",
                    i % 2 ? "rotate-1" : "-rotate-1",
                  ]}
                  data-vault-item
                >
                  <span class="pin"></span>
                  <div class="flex items-center gap-4">
                    <span class:list={["badge-medal", medal(g.tier)]} aria-hidden="true">{g.icon}</span>
                    <span class="vault-chip">{g.role}</span>
                  </div>
                  <h3 class="mt-3 font-display text-[1.3rem] leading-snug text-[#3a1f72]">
                    {g.href ? (
                      <a class="underline decoration-[3px] underline-offset-4 hover:text-ruby" href={g.href} target={isExternal(g.href) ? "_blank" : undefined} rel={isExternal(g.href) ? "noopener noreferrer" : undefined}>{g.name}</a>
                    ) : (
                      g.name
                    )}
                  </h3>
                  {g.detail && <p class="font-bold leading-snug">{g.detail}</p>}
                  {g.period && <p class="mt-auto text-sm font-extrabold italic text-[#5a3a12]">{g.period}</p>}
                </li>
              ))}

              {lockedFor(guilds.length).map((_, i) => (
                <li
                  class:list={["guild-note is-open relative grid min-h-48 place-items-center rounded-xl px-4 py-6 text-center", (guilds.length + i) % 2 ? "rotate-1" : "-rotate-1"]}
                  data-vault-item
                  aria-label="Guild slot, open"
                >
                  <span class="pin opacity-60" aria-hidden="true"></span>
                  <span class="flex flex-col items-center gap-2" aria-hidden="true">
                    <span class="text-3xl">🔒</span>
                    <span class="font-display text-lg tracking-widest">OPEN SLOT</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Accessible tabs (WAI-ARIA pattern): click, or ←/→/Home/End on the tab bar.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const vault = document.querySelector<HTMLElement>("[data-vault]");
  if (vault) {
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tabs = [...vault.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") ?? ""));
    let current = Math.max(0, tabs.findIndex((t) => t.getAttribute("aria-selected") === "true"));

    const select = (index: number, focus = false) => {
      if (focus) tabs[index].focus();
      if (index === current) return;
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i]?.toggleAttribute("hidden", !on);
      });
      // the vault just changed height: re-measure scroll-driven effects further down the page
      ScrollTrigger.refresh();
      const items = panels[index]?.querySelectorAll("[data-vault-item]");
      if (!reduceMotion && items?.length) {
        gsap.fromTo(
          items,
          { opacity: 0, y: 26, scale: 0.92 },
          { opacity: 1, y: 0, scale: 1, duration: 0.45, stagger: 0.06, ease: "back.out(1.7)", overwrite: true, clearProps: "opacity,transform" },
        );
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const keys: Record<string, number> = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(keys[e.key], true);
      });
    });
  }
</script>

<style>
  /* ---------- vault frame: riveted stone chest ---------- */
  .vault {
    position: relative;
    padding: 1rem 0.75rem 0.75rem;
    border: 4px solid var(--color-ink);
    border-radius: 26px;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.16), rgb(0 0 0 / 0.18)),
      url("/textures/stone.svg") 0 0 / 240px 240px;
    box-shadow: var(--shadow-hard), inset 0 6px 0 rgb(255 255 255 / 0.3), inset 0 -8px 0 rgb(0 0 0 / 0.25);
  }
  .vault__floor {
    margin-top: 1.25rem;
    padding: 1.5rem 0.9rem;
    border: 4px solid var(--color-ink);
    border-radius: 18px;
    background:
      radial-gradient(90% 60% at 50% 0%, rgb(166 107 255 / 0.22), transparent 70%),
      linear-gradient(180deg, #171037, #0d0826);
    box-shadow: inset 0 8px 0 rgb(0 0 0 / 0.45), inset 0 -3px 0 rgb(255 255 255 / 0.06);
  }
  @media (min-width: 640px) {
    .vault { padding: 1.5rem; }
    .vault__floor { padding: 2rem 1.75rem; }
  }

  /* ---------- tabs: slate buttons that light up as gems when selected ---------- */
  .vault-tabs { display: flex; flex-wrap: wrap; gap: 0.6rem 0.7rem; }
  .vault-tab {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.6rem 0.5rem 0.85rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow: 0 2px 0 var(--color-ink), 1px 0 0 var(--color-ink), -1px 0 0 var(--color-ink), 0 -1px 0 var(--color-ink);
    border: 3px solid var(--color-ink);
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(0 0 0 / 0.25)),
      url("/textures/slate.svg") 0 0 / 180px 180px;
    box-shadow: 0 5px 0 var(--color-ink), inset 0 3px 0 rgb(255 255 255 / 0.18);
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.15s ease;
  }
  .vault-tab:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 var(--color-ink), inset 0 3px 0 rgb(255 255 255 / 0.18), 0 0 16px var(--gem-glow);
  }
  .vault-tab[aria-selected="true"] {
    transform: translateY(5px);
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0.4) 0 16%, transparent 16.5%),
      linear-gradient(0deg, rgb(0 0 0 / 0.22) 0 30%, transparent 30.5%),
      linear-gradient(180deg, var(--gem-light), var(--gem-mid) 55%, var(--gem-dark));
    box-shadow: 0 0 0 var(--color-ink), inset 0 3px 0 rgb(255 255 255 / 0.35), 0 0 20px var(--gem-glow);
  }
  .vault-tab__count {
    display: grid; place-items: center;
    min-width: 1.7rem; height: 1.7rem;
    padding-inline: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 900;
    color: var(--color-ink);
    text-shadow: none;
    background: var(--color-gold);
    border: 3px solid var(--color-ink);
    border-radius: 999px;
  }
  .vault-tab[aria-selected="true"] .vault-tab__count { background: #fff; }
  .gem-gold { --gem-light: #fff0b3; --gem-mid: #ffd25e; --gem-dark: #c98a12; --gem-glow: rgb(255 210 94 / 0.7); }

  /* ---------- small labels ---------- */
  .vault-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    width: fit-content;
    padding: 0.2rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-gold);
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 0 2px 0 var(--color-ink);
  }
  .vault-chip.is-dark { color: var(--color-lilac); background: var(--color-night-0); }
  .vault-tag {
    padding: 0.2rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: #eef1ff;
    border: 2px solid var(--color-ink);
    border-radius: 8px;
    background: linear-gradient(180deg, #1a1f36, #252c4a);
    box-shadow: inset 0 2px 0 rgb(0 0 0 / 0.4), 0 2px 0 var(--color-ink);
  }

  /* ---------- achievements: trophy plinths ---------- */
  .trophy {
    position: relative;
    isolation: isolate; /* keeps the medal ribbons above the card background */
    display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
    min-height: 15rem;
    padding: 1.5rem 1.25rem 1.4rem;
    text-align: center;
    border: 4px solid var(--color-ink);
    border-radius: 18px;
    background:
      radial-gradient(70% 50% at 50% 18%, rgb(255 210 94 / 0.22), transparent 70%),
      linear-gradient(160deg, rgb(255 255 255 / 0.08), rgb(0 0 0 / 0.25)),
      url("/textures/slate.svg") 0 0 / 240px 240px;
    box-shadow: var(--shadow-hard-sm), inset 0 5px 0 rgb(255 255 255 / 0.18), inset 0 -7px 0 rgb(0 0 0 / 0.3);
    transition: transform 0.2s ease, box-shadow 0.25s ease;
  }
  .trophy:hover {
    transform: translateY(-5px) rotate(-0.6deg);
    box-shadow: 4px 10px 0 var(--color-ink), 0 0 30px rgb(255 210 94 / 0.45);
  }
  .trophy > .badge-medal { margin-bottom: 1.5rem; }
  .trophy.is-locked {
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.04), rgb(0 0 0 / 0.38)),
      url("/textures/slate.svg") 0 0 / 240px 240px;
  }
  .trophy.is-locked:hover { box-shadow: 4px 10px 0 var(--color-ink), 0 0 26px rgb(166 107 255 / 0.4); }

  /* ---------- medal tiers (gold + cyan come from global.css) ---------- */
  .badge-medal.is-silver { background: radial-gradient(circle at 35% 30%, #ffffff 0 12%, #d9deea 13% 55%, #8a93a6 56%); }
  .badge-medal.is-bronze { background: radial-gradient(circle at 35% 30%, #ffe3c7 0 12%, #e39a57 13% 55%, #9a5a26 56%); }
  .badge-medal.is-ruby { background: radial-gradient(circle at 35% 30%, #ffd3de 0 12%, #ff6b8b 13% 55%, #9b0f33 56%); }
  .badge-medal.is-amethyst { background: radial-gradient(circle at 35% 30%, #efe5ff 0 12%, #a66bff 13% 55%, #5b23b5 56%); }
  .badge-medal.is-locked {
    font-family: var(--font-display);
    color: #eef1ff;
    text-shadow: 0 3px 0 var(--color-ink);
    background: radial-gradient(circle at 35% 30%, #d5dae6 0 12%, #8a93a6 13% 55%, #5b6378 56%);
  }
  .badge-medal.is-locked::before,
  .badge-medal.is-locked::after { background: #5b6378; }

  /* ---------- guilds: empty pin spot on the cork board ---------- */
  .guild-note.is-open {
    color: rgb(42 29 16 / 0.7);
    border: 4px dashed rgb(11 11 18 / 0.55);
    background: rgb(255 246 218 / 0.18);
  }
</style>
