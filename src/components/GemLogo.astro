---
// Gemsteak brand mark: steak cut with faceted ruby-crystal meat and a stone rind.
// Source art: src/assets/gemsteak-logo.png (transparent, square). Favicons in public/ are cut from the same file.
import { Image } from "astro:assets";
import logo from "../assets/gemsteak-logo.png";

interface Props {
  size?: number;
  class?: string;
  loading?: "eager" | "lazy";
}
const { size = 48, class: className = "", loading = "lazy" } = Astro.props;
---

<Image
  src={logo}
  alt="Gemsteak logo"
  width={size}
  height={size}
  densities={[1, 2, 3]}
  loading={loading}
  decoding="async"
  class:list={["inline-block select-none", className]}
  draggable="false"
/>
