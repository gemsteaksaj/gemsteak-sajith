---
import GemLogo from "./GemLogo.astro";
import { hero } from "../data/cv";
const year = new Date().getFullYear();
const links = hero.contacts.filter((c) => c.href);
---

<footer class="relative mt-12 border-t-4 border-ink bg-night-0/85">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-10 md:flex-row md:justify-between">
    <div class="flex items-center gap-3">
      <GemLogo size={52} uid="footer-logo" />
      <div>
        <p class="font-display text-2xl tracking-wide text-ruby-light [text-shadow:0_3px_0_var(--color-ink)]">GEMSTEAK STUDIOS</p>
        <p class="text-sm text-lilac/80">© {year} Gemsteak Studios · Sajith KP</p>
      </div>
    </div>
    <ul class="flex flex-wrap justify-center gap-3">
      {links.map((c) => (
        <li>
          <a class="btn-stone text-sm" href={c.href!} target={c.href!.startsWith("http") ? "_blank" : undefined} rel={c.href!.startsWith("http") ? "noopener noreferrer" : undefined}>
            <span aria-hidden="true">{c.icon}</span>
            <span class="sr-only">{c.label}</span>
            <span aria-hidden="true" class="hidden sm:inline">{c.label.replace("Instagram: ", "")}</span>
          </a>
        </li>
      ))}
      <li><a class="btn-stone text-sm" href="#top">▲ Main Menu</a></li>
    </ul>
  </div>
</footer>
